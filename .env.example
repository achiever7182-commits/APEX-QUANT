# ==============================================================================
# APEX QUANT & TRADING PLATFORM CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Never commit your real '.env' file or credentials to version control!
# Copy this file to '.env' and populate with your test/sandbox credentials.

# ------------------------------------------------------------------------------
# 1. LEGACY / BINANCE TESTNET ENGINE (Active)
# ------------------------------------------------------------------------------
# Free testnet API keys from: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_binance_testnet_api_secret_here

# Runtime Trading Mode (testnet / paper)
PAPER_TRADING=true
TRADING_MODE=testnet

# ML Model Target for Crypto
ML_SYMBOL=BTC/USDT
ML_TIMEFRAME=5m
ML_MIN_CONFIDENCE=0.60

# ------------------------------------------------------------------------------
# 2. APEX QUANT — INDIAN EQUITY PLATFORM (Step 1 Architecture Template)
# ------------------------------------------------------------------------------
# Target Market & Universe Configuration
APEX_MARKET=NSE
APEX_UNIVERSE=NIFTY500
APEX_TIMEFRAME=1d

# Broker Selection: PAPER | ZERODHA | SHOONYA | DHAN (Default: PAPER)
APEX_BROKER=PAPER

# Future Indian Broker API Keys (Placeholders - DO NOT enter live keys until Stage 7)
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# SHOONYA_USER_ID=
# SHOONYA_PASSWORD=
# SHOONYA_API_KEY=

# Risk Management Parameters (Apex Quant Defaults)
APEX_MAX_PORTFOLIO_RISK_PCT=0.02
APEX_MAX_POSITION_SIZE_PCT=0.05
APEX_MAX_DRAWDOWN_LIMIT_PCT=0.10
APEX_CIRCUIT_BREAKER_PCT=0.05

# Database Configuration (Default: local SQLite database)
DATABASE_URL=sqlite:///apex_quant.db
